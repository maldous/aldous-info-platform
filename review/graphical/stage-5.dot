"node-provider" [id="node-provider",label="ChatGPT /\nClaude sessions"];
"node-delivery" [id="node-delivery",label="Delivery workflow"];
"node-langgraph" [id="node-langgraph",label="LangGraph"];
"node-sqlite" [id="node-sqlite",label="SQLite checkpoints"];
"node-stokowski" [id="node-stokowski",label="Stokowski",color="#b34c31",penwidth="2.5"];
"node-supervisor" [id="node-supervisor",label="Coding supervisor",color="#b34c31",penwidth="2.5"];
"node-journal" [id="node-journal",label="Operation journal",color="#b34c31",penwidth="2.5"];
"node-linear" [id="node-linear",label="Linear",color="#b34c31",penwidth="2.5"];
"node-runner" -> "node-code" [id="edge-runner->code",label="Local subprocess"];
"node-workspace" -> "node-github" [id="edge-workspace->github",label="Git / SSH"];
"node-github" -> "node-pr" [id="edge-github->pr",label="HTTPS API"];
"node-pr" -> "node-review" [id="edge-pr->review",label="HTTPS API"];
